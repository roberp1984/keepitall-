# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (claims + orders). Server-side only: tables have RLS with no policies.
# Apply supabase/migrations/*.sql to your project first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (payments; webhook is the source of truth for "paid").
# Webhook endpoint: <site>/api/webhooks/stripe, events: checkout.session.completed,
# checkout.session.async_payment_succeeded, charge.refunded.
# One product, two one-time EUR prices (tax-inclusive): EU261 claims 19.00, UK261 claims 18.00 (must match lib/pricing.json).
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_EUR=
STRIPE_PRICE_ID_GBP=
STRIPE_WEBHOOK_SECRET=
# "true" to have Stripe Tax calculate VAT at checkout (set up your tax registrations in Stripe first).
STRIPE_AUTOMATIC_TAX=

# Anthropic (letter drafting only — never eligibility or amounts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="KeepItAll <claims@example.com>"

# Analytics: Umami Cloud, configured in lib/site.json (website ID is not secret). Nothing to set here.

# Daily cron (follow-up emails + data retention). Vercel sends it as a Bearer token.
CRON_SECRET=
