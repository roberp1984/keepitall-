# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (claims + orders). Server-side only: tables have RLS with no policies.
# Apply supabase/migrations/*.sql to your project first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (payments; webhook is the source of truth for "paid").
# Webhook URL: <site>/api/webhooks/lemonsqueezy, events: order_created, order_refunded.
# One product, two variants, store currency EUR: EU261 claims 19.00, UK261 claims 18.00 (must match lib/pricing.json).
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_EUR=
LEMONSQUEEZY_VARIANT_ID_GBP=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Anthropic (letter drafting only — never eligibility or amounts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="KeepItAll <claims@example.com>"

# PostHog (funnel analytics). Cookieless: enable "cookieless mode" in the PostHog project settings.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Daily cron (follow-up emails + data retention). Vercel sends it as a Bearer token.
CRON_SECRET=
