# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (claims + orders)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (payments; webhook is the source of truth for "paid")
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID_EUR=
LEMONSQUEEZY_VARIANT_ID_GBP=
LEMONSQUEEZY_WEBHOOK_SECRET=

# Anthropic (letter drafting only — never eligibility or amounts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="KeepItAll <claims@example.com>"

# PostHog (funnel analytics)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
