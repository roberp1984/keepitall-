# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (claims + orders). Server-side only: tables have RLS with no policies.
# Apply supabase/migrations/*.sql to your project first.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Paddle Billing (payments; webhook is the source of truth for "paid").
# Notification destination: <site>/api/webhooks/paddle, events: transaction.completed, adjustment.created, adjustment.updated.
# One product, two one-time EUR prices: EU261 claims 19.00, UK261 claims 18.00 (must match lib/pricing.json).
# Default payment link (Checkout settings): <site>/pay
# Sandbox keys contain "_sdbx_" and sandbox client tokens start with "test_"; set PADDLE_ENVIRONMENT to override.
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_ID_EUR=
PADDLE_PRICE_ID_GBP=
PADDLE_WEBHOOK_SECRET=
PADDLE_ENVIRONMENT=

# Anthropic (letter drafting only — never eligibility or amounts)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="KeepItAll <claims@example.com>"

# PostHog (funnel analytics). Cookieless: enable "cookieless mode" in the PostHog project settings.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Daily cron (follow-up emails + data retention). Vercel sends it as a Bearer token.
CRON_SECRET=
